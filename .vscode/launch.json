{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug wxWidgets App",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/app.exe",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "miDebuggerPath": "gdb",
        "preLaunchTask": "Build wxWidgets App",
        "internalConsoleOptions": "openOnSessionStart",
        "logging": {
          "engineLogging": false
        }
      }
    ]
  }
  